{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build && npm run migrate",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/v1/internal/storage/cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v1/internal/champions/cron",
      "schedule": "5 17 * * 0"
    }
  ]
}
