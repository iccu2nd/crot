# Hanya dua ini yang wajib (PORT opsional, biasanya diisi otomatis oleh hosting)
DATABASE_URL=postgres://scraper:scraper@localhost:5432/scraper
REDIS_URL=redis://localhost:6379

# Opsional: relay Cloudflare Worker untuk Lumos jika kena HTTP 403 dari Vercel (lihat relay/lumos-worker.js)
# LUMOS_RELAY=https://lumos-relay.<akun>.workers.dev
# LUMOS_RELAY_KEY=rahasia

# Opsional: API unified lain (mis. deploy Railway) sebagai jalur cadangan Lumos saat IP Vercel diblokir (403)
# LUMOS_UPSTREAM=https://nama-app.up.railway.app
