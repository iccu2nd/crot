# Salin ke .env lalu isi. Buat rahasia dengan: openssl rand -hex 32

# ===== Docker compose =====
POSTGRES_PASSWORD=
# Port host untuk API (opsional)
# PORT=3000

# ===== Aplikasi =====
# WAJIB di produksi: rahasia penanda token login
JWT_SECRET=
# Opsional: mengaktifkan endpoint admin. Kosong = nonaktif.
ADMIN_TOKEN=
# Opsional: OAuth *Web* client ID untuk Masuk dengan Google. Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=
# Opsional: email owner (pisah koma) -> otomatis verified + akses /v1/admin/*
# OWNER_EMAILS=

# ===== Tanpa docker compose (npm start) =====
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379
