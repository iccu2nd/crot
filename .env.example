# Hanya dua ini yang wajib (PORT opsional, biasanya diisi otomatis oleh hosting)
DATABASE_URL=postgres://scraper:scraper@localhost:5432/scraper
REDIS_URL=redis://localhost:6379
# Opsional: isi untuk mengaktifkan endpoint admin pengumuman (POST/DELETE /v1/admin/announcements). Kosong = nonaktif.
# ADMIN_TOKEN=ganti-dengan-string-acak-panjang

# ---- Akun & login (layar login di aplikasi) ----
# WAJIB di produksi: rahasia penanda token login. Buat dengan: openssl rand -hex 32
JWT_SECRET=
# Masuk dengan Google: OAuth *Web* client ID (Google Cloud Console). Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=
# Email owner (pisah koma) yang otomatis dapat centang verified saat masuk lewat Google. Default: hihanghoheng1507@gmail.com
# OWNER_EMAILS=hihanghoheng1507@gmail.com
