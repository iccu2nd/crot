# Salin ke .env lalu isi. Buat rahasia dengan: openssl rand -hex 32

# ===== Docker compose =====
POSTGRES_PASSWORD=
# Port host untuk API (opsional)
# PORT=3000

# ===== Aplikasi =====
# WAJIB di produksi: rahasia penanda token login
JWT_SECRET=
# Opsional: mengaktifkan endpoint admin. Kosong = nonaktif.
ADMIN_TOKEN=
# Opsional: OAuth *Web* client ID untuk Masuk dengan Google. Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=
# Jumlah reverse proxy tepercaya di depan app (default 1 = Railway/Vercel/Nginx). Salah isi = rate limit per-IP bisa dilewati/semua klien dianggap satu IP.
# TRUST_PROXY=1
# Opsional: email owner (pisah koma) -> otomatis verified + akses /v1/admin/*
# OWNER_EMAILS=

# ===== Manajemen storage database =====
# Kapasitas database (MB, desimal). Default 200. Peringatan 70/80/90/95%.
# STORAGE_LIMIT_MB=200
# Webhook peringatan (Discord/Slack/generik, menerima JSON {text, content, level, percent}). Kosong = hanya log + riwayat.
# STORAGE_ALERT_WEBHOOK_URL=
# Rahasia cron Vercel (GET /v1/internal/storage/cron). Kosong = endpoint nonaktif.
# CRON_SECRET=
# Backup otomatis harian ke BACKUP_DIR (docker compose: volume backups). Simpan salinan di luar server juga.
# BACKUP_ENABLED=1
# BACKUP_DIR=backups
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# STORAGE_MANAGER=0 mematikan seluruh manajemen storage

# ===== Tanpa docker compose (npm start) =====
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379
# Komiku (opsional)
# KOMIKU_BASE=https://komiku.org
# KOMIKU_API=https://api.komiku.org
# KOMIKU_COOKIE=cf_clearance=...
# KOMIKU_UA=
